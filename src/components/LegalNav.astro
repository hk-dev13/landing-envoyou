---
export interface Props {
  currentPage: 'terms' | 'privacy' | 'refund' | 'analytics';
}

const { currentPage } = Astro.props;

const legalPages = [
  {
    id: 'terms',
    title: 'Terms of Service',
    shortTitle: 'Terms',
    href: '/terms',
  },
  {
    id: 'privacy',
    title: 'Privacy Policy',
    shortTitle: 'Privacy',
    href: '/privacy',
  },
  {
    id: 'refund',
    title: 'Refund Policy',
    shortTitle: 'Refunds',
    href: '/refund',
  },
  {
    id: 'analytics',
    title: 'Analytics & Preferences',
    shortTitle: 'Analytics',
    href: '/analytics',
  },
];

const currentIndex = legalPages.findIndex((p) => p.id === currentPage);
const prevPage = legalPages[(currentIndex - 1 + legalPages.length) % legalPages.length];
const nextPage = legalPages[(currentIndex + 1) % legalPages.length];
---

<nav aria-label="Legal pages navigation" class="mt-16 pt-8 border-t border-border/50">
  <!-- Inline Directory Navigation -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-x-6 gap-y-3 mb-8 text-xs">
    <span class="font-bold text-muted uppercase tracking-wider">
      Legal Directory
    </span>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-muted">
      {legalPages.map((page, index) => {
        const isActive = page.id === currentPage;
        return (
          <>
            {index > 0 && <span class="text-muted/30 select-none">•</span>}
            <a
              href={page.href}
              class={`transition-colors duration-150 ${
                isActive
                  ? 'text-primary font-semibold underline underline-offset-4'
                  : 'text-muted hover:text-text'
              }`}
            >
              {page.shortTitle}
            </a>
          </>
        );
      })}
    </div>
  </div>

  <!-- Prev / Next Typographic Pagination -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-6 border-t border-border/30">
    <!-- Previous Link -->
    <a
      href={prevPage.href}
      class="group flex flex-col gap-1 text-left transition-colors duration-150"
    >
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted group-hover:text-primary transition-colors">
        <svg class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Previous Policy
      </span>
      <span class="text-base font-bold text-text group-hover:text-primary transition-colors">
        {prevPage.title}
      </span>
    </a>

    <!-- Next Link -->
    <a
      href={nextPage.href}
      class="group flex flex-col gap-1 sm:items-end text-left sm:text-right transition-colors duration-150"
    >
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted group-hover:text-primary transition-colors">
        Next Policy
        <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
      <span class="text-base font-bold text-text group-hover:text-primary transition-colors">
        {nextPage.title}
      </span>
    </a>
  </div>
</nav>
