---
// Navbar component with theme toggle and sticky behavior
interface Props {
  hasInvertedHero?: boolean;
}

const { hasInvertedHero } = Astro.props;
const pathname = Astro.url.pathname;
const isHomePage = pathname === '/' || pathname === '';
const defaultInverted = hasInvertedHero ?? isHomePage;
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  data-scrolled="false"
  data-hero-inverted={defaultInverted ? "true" : "false"}
>
  <nav class="max-w-screen mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-1.5 group logo-link"
      aria-label="Envoyou Home"
    >
      <div class="w-6 h-6 flex items-center justify-center group-hover:brightness-110 transition-all duration-200 logo-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600">
          <path 
            fill="currentColor" 
            stroke="currentColor" 
            stroke-width="20" 
            stroke-linejoin="round" 
            stroke-linecap="round" 
            d="M289 67v56h22V10h-22zm89 11-21 53q0 2 9 5l10 4 1-2 21-52c22-56 21-51 15-53l-10-4-5-2zM187 33l-10 4 44 104 19-8-44-104zM95 95l-7 8 40 40 39 40 8-8 8-8-40-39-40-40zm362 33-39 39 7 8 8 8 40-40 39-40-7-8-8-7zm53 71-51 22 8 19 103-43 1-1-9-19zM34 184l-4 9-3 9 104 41q2 0 5-9l4-10-3-1-51-21-50-20zM10 300v11h113v-22H10zm279 0v11h301v-22H289zm178 58-4 10-3 8 3 1 51 21 50 19c1 1 9-18 9-19zM92 377l-51 22-12 5 9 19 103-44-9-19zm36 80-39 40 15 15 40-39 39-40-7-7-8-8zm298-31-7 7 39 40 40 39 15-15-79-79zm-56 37-9 4 20 48 22 51 1 5 20-9-45-103zm-146 0-40 101 19 9 41-104q0-2-9-5l-10-4zm66 71v56h22V477h-22z"
          />
        </svg>
      </div>
      <span class="text-lg font-bold tracking-tight logo-text">Envoyou</span>
    </a>

    <!-- Center Nav Links -->
    <div class="hidden md:flex items-center gap-1">
      <a href="/#products" class="nav-link">Product</a>
      <a href="/#how-it-works" class="nav-link">How It Works</a>
      <a href="/pricing" class="nav-link">Pricing</a>
      <a href="/#case-study" class="nav-link">Case Study</a>
      <a href="/#security" class="nav-link">Security</a>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-3">
      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        class="w-9 h-9 rounded-full flex items-center justify-center text-muted hover:text-text hover:bg-surface-soft transition-all duration-200"
        aria-label="Toggle theme"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="icon-sun" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="icon-moon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- CTA -->
      <a
        href="https://eai.envoyou.com/login"
        data-analytics-event="eai_login_clicked"
        data-analytics-location="navbar_desktop"
        class="hidden md:inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold transition-colors duration-200 shadow-sm"
        style="background-color: var(--color-primary); color: var(--color-on-primary);"
        onmouseover="this.style.backgroundColor='var(--color-primary-deep)', this.style.color='var(--color-on-primary)'"
        onmouseout="this.style.backgroundColor='var(--color-primary)', this.style.color='var(--color-on-primary)'"
      >
        Log in to EAI
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M7 17L17 7M17 7H7M17 7v10"/>
        </svg>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden w-9 h-9 rounded-full border flex items-center justify-center transition-all duration-200"
        aria-label="Open menu"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-border bg-surface/95 backdrop-blur-xl px-6 py-4 space-y-1"
  >
    <a href="/#products" class="mobile-nav-link">Product</a>
    <a href="/#how-it-works" class="mobile-nav-link">How It Works</a>
    <a href="/pricing" class="mobile-nav-link">Pricing</a>
    <a href="/#case-study" class="mobile-nav-link">Case Study</a>
    <a href="/#security" class="mobile-nav-link">Security</a>
    <div class="pt-3 border-t border-border flex gap-2">
      <a
        href="https://eai.envoyou.com/login"
        data-analytics-event="eai_login_clicked"
        data-analytics-location="navbar_mobile"
        class="flex-1 text-center px-4 py-2 rounded-full bg-primary text-on-primary text-sm font-semibold"
      >
        Log in to EAI
      </a>
    </div>
  </div>
</header>

<script>
  // Navbar scroll effect
  const navbar = document.getElementById("navbar");
  function updateScrollState() {
    const scrolled = window.scrollY > 20;
    navbar?.setAttribute("data-scrolled", scrolled ? "true" : "false");
  }

  function checkHeroInverted() {
    const hasHeroInverted = !!document.querySelector(".hero-inverted");
    if (navbar) {
      navbar.setAttribute("data-hero-inverted", hasHeroInverted ? "true" : "false");
    }
  }

  checkHeroInverted();
  window.addEventListener("scroll", updateScrollState);
  // Run on initial load
  updateScrollState();

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  
  mobileMenuBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    mobileMenu?.classList.toggle("hidden");
  });

  // Close mobile menu when clicking outside
  document.addEventListener("click", (event) => {
    const target = event.target as Node | null;
    if (
      mobileMenu &&
      !mobileMenu.classList.contains("hidden") &&
      target &&
      !mobileMenu.contains(target) &&
      !mobileMenuBtn?.contains(target)
    ) {
      mobileMenu.classList.add("hidden");
    }
  });

  // Close mobile menu on link click
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => mobileMenu?.classList.add("hidden"));
  });

  // Theme toggle
  const themeToggle = document.getElementById("theme-toggle");
  const iconSun = document.getElementById("icon-sun");
  const iconMoon = document.getElementById("icon-moon");

  function updateIcons() {
    const isDark = document.documentElement.classList.contains("dark");
    iconSun?.classList.toggle("hidden", !isDark);
    iconMoon?.classList.toggle("hidden", isDark);
  }

  updateIcons();

  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    updateIcons();
  });

  // Trigger navigation on hover with a small delay to prevent accidental triggers
  let hoverTimeout: any;
  document.querySelectorAll(".nav-link").forEach((link) => {
    link.addEventListener("mouseenter", () => {
      const href = link.getAttribute("href");
      if (href) {
        hoverTimeout = setTimeout(() => {
          window.location.href = href;
        }, 250); // 250ms delay
      }
    });

    link.addEventListener("mouseleave", () => {
      clearTimeout(hoverTimeout);
    });
  });
</script>

<style>
  #navbar {
    border-bottom: 1px solid transparent;
  }

  .logo-text, .logo-icon {
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  /* ScrolledNavbar (over normal sections) */
  #navbar[data-scrolled="true"] {
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(20px);
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 20px rgba(0, 0, 0, 0.06);
  }

  /* Top Navbar (scrolled=false over inverted Hero) */
  #navbar[data-hero-inverted="true"][data-scrolled="false"] .logo-text,
  #navbar[data-hero-inverted="true"][data-scrolled="false"] .logo-icon {
    color: #f7f8f8;
  }

  :global(.dark) #navbar[data-hero-inverted="true"][data-scrolled="false"] .logo-text,
  :global(.dark) #navbar[data-hero-inverted="true"][data-scrolled="false"] .logo-icon {
    color: #0f1115;
  }

  #navbar[data-hero-inverted="true"][data-scrolled="false"] .nav-link {
    color: #9da3ae;
  }

  #navbar[data-hero-inverted="true"][data-scrolled="false"] .nav-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
  }

  :global(.dark) #navbar[data-hero-inverted="true"][data-scrolled="false"] .nav-link {
    color: #626770;
  }

  :global(.dark) #navbar[data-hero-inverted="true"][data-scrolled="false"] .nav-link:hover {
    color: #0f1115;
    background-color: rgba(0, 0, 0, 0.06);
  }

  #navbar[data-hero-inverted="true"][data-scrolled="false"] #theme-toggle {
    color: #9da3ae;
  }

  #navbar[data-hero-inverted="true"][data-scrolled="false"] #theme-toggle:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
  }

  :global(.dark) #navbar[data-hero-inverted="true"][data-scrolled="false"] #theme-toggle {
    color: #626770;
  }

  :global(.dark) #navbar[data-hero-inverted="true"][data-scrolled="false"] #theme-toggle:hover {
    color: #0f1115;
    background-color: rgba(0, 0, 0, 0.06);
  }

  /* Mobile Burger Button Contrast */
  #mobile-menu-btn {
    background-color: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  #navbar[data-hero-inverted="true"][data-scrolled="false"] #mobile-menu-btn {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.18);
    color: #ffffff;
  }

  :global(.dark) #navbar[data-hero-inverted="true"][data-scrolled="false"] #mobile-menu-btn {
    background-color: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.12);
    color: #0f1115;
  }

  .nav-link {
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color 0.2s, background-color 0.2s;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--color-text);
    background-color: color-mix(in srgb, var(--color-surface-soft) 80%, transparent);
  }

  .mobile-nav-link {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color 0.2s, background-color 0.2s;
    text-decoration: none;
  }

  .mobile-nav-link:hover {
    color: var(--color-text);
    background-color: var(--color-surface-soft);
  }
</style>

