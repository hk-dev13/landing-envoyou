---
// ScrollSystem.astro — Top Scroll Progress Bar & Floating Back-to-Top Button
---

<!-- Top Scroll Progress Bar (Fixed at top of screen) -->
<div class="fixed top-0 left-0 right-0 z-[100] h-[3.5px] pointer-events-none bg-transparent">
  <div 
    id="top-scroll-progress"
    class="h-full bg-gradient-to-r from-sky-400 via-indigo-500 to-primary shadow-[0_0_10px_rgba(56,189,248,0.8)]"
    style="width: 0%; transition: width 0.08s linear;"
  ></div>
</div>

<!-- Floating Back to Top Button -->
<div class="fixed right-6 bottom-6 z-40 pointer-events-none" id="scroll-system-wrapper">
  <button
    id="scroll-system-button"
    type="button"
    class="relative flex items-center justify-center w-11 h-11 rounded-full border border-border bg-surface text-text shadow-lg backdrop-blur-md transition-all duration-300 ease-out pointer-events-none opacity-0 scale-90 hover:scale-105 hover:-translate-y-1 hover:border-primary active:scale-95"
    aria-label="Back to top"
  >
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M18 15l-6-6-6 6"/>
    </svg>
  </button>
</div>

<script>
  function initScrollProgress() {
    const progressBar = document.getElementById('top-scroll-progress');
    const backToTopBtn = document.getElementById('scroll-system-button');

    if (!progressBar || !backToTopBtn) return;

    let ticking = false;

    const updateScrollProgress = () => {
      const scrollY = window.scrollY || document.documentElement.scrollTop;
      const totalScrollable = document.documentElement.scrollHeight - window.innerHeight;
      
      // Calculate 0 to 100% progress
      const percentage = totalScrollable > 0 ? Math.max(0, Math.min(100, (scrollY / totalScrollable) * 100)) : 0;
      progressBar.style.width = `${percentage}%`;

      // Show back to top button after scrolling down 250px
      if (scrollY > 250) {
        backToTopBtn.classList.remove('opacity-0', 'scale-90', 'pointer-events-none');
        backToTopBtn.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
      } else {
        backToTopBtn.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
        backToTopBtn.classList.add('opacity-0', 'scale-90', 'pointer-events-none');
      }

      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateScrollProgress);
        ticking = true;
      }
    };

    // Attach scroll and resize listeners
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // Back to top click handler
    backToTopBtn.onclick = () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // Initial update
    updateScrollProgress();
  }

  // Support DOMContentLoaded and Astro page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollProgress);
  } else {
    initScrollProgress();
  }
  document.addEventListener('astro:page-load', initScrollProgress);
</script>
