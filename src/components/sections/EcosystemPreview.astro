<script>
  // Top Outer Tab Switcher (Workspace vs E-Blog)
  const tabBtnEai = document.getElementById('tab-btn-eai');
  const tabBtnBlog = document.getElementById('tab-btn-blog');
  const tabContentEai = document.getElementById('tab-content-eai');
  const tabContentBlog = document.getElementById('tab-content-blog');
  const windowTitle = document.getElementById('window-title');

  tabBtnEai?.addEventListener('click', () => {
    tabBtnEai.classList.add('active', 'bg-surface-soft', 'text-text');
    tabBtnBlog?.classList.remove('active', 'bg-surface-soft', 'text-text');
    tabContentEai?.classList.remove('hidden');
    tabContentEai?.classList.add('active');
    tabContentBlog?.classList.add('hidden');
    if (windowTitle) windowTitle.textContent = 'https://eai.envoyou.com/workspace';
  });

  tabBtnBlog?.addEventListener('click', () => {
    tabBtnBlog.classList.add('active', 'bg-surface-soft', 'text-text');
    tabBtnEai?.classList.remove('active', 'bg-surface-soft', 'text-text');
    tabContentBlog?.classList.remove('hidden');
    tabContentBlog?.classList.add('active');
    tabContentEai?.classList.add('hidden');
    if (windowTitle) windowTitle.textContent = 'https://e-blog.envoyou.com/admin/drafts/142';
  });

  // 1. COLLAPSIBLE SIDEBAR TOGGLE (PanelLeft icon)
  const sidebar = document.getElementById('eai-sidebar');
  const sidebarToggleBtn = document.getElementById('sidebar-toggle-btn');

  sidebarToggleBtn?.addEventListener('click', () => {
    const isOpen = sidebar?.getAttribute('data-sidebar-open') === 'true';
    if (isOpen) {
      sidebar?.setAttribute('data-sidebar-open', 'false');
      sidebar?.classList.remove('lg:w-[240px]', 'w-[240px]');
      sidebar?.classList.add('lg:w-[60px]', 'w-[60px]');
      document.querySelectorAll('.sidebar-text').forEach((el) => el.classList.add('hidden'));
    } else {
      sidebar?.setAttribute('data-sidebar-open', 'true');
      sidebar?.classList.remove('lg:w-[60px]', 'w-[60px]');
      sidebar?.classList.add('lg:w-[240px]', 'w-[240px]');
      document.querySelectorAll('.sidebar-text').forEach((el) => el.classList.remove('hidden'));
    }
  });

  // 2. INNER WORKSPACE VIEW SWITCHER (Editor vs Dashboard)
  const navEditorBtn = document.getElementById('nav-item-editor');
  const navDashboardBtn = document.getElementById('nav-item-dashboard');
  const viewEditor = document.getElementById('view-editor');
  const viewDashboard = document.getElementById('view-dashboard');

  navEditorBtn?.addEventListener('click', () => {
    navEditorBtn.classList.add('bg-white/10', 'text-white');
    navEditorBtn.classList.remove('text-gray-400');
    navDashboardBtn?.classList.remove('bg-white/10', 'text-white');
    navDashboardBtn?.classList.add('text-gray-400');

    viewEditor?.classList.remove('hidden');
    viewDashboard?.classList.add('hidden');
  });

  navDashboardBtn?.addEventListener('click', () => {
    navDashboardBtn.classList.add('bg-white/10', 'text-white');
    navDashboardBtn.classList.remove('text-gray-400');
    navEditorBtn?.classList.remove('bg-white/10', 'text-white');
    navEditorBtn?.classList.add('text-gray-400');

    viewDashboard?.classList.remove('hidden');
    viewEditor?.classList.add('hidden');
  });

  // 3. RIGHT PANEL TAB SWITCHER & FLOATING TOGGLE
  const rightPanel = document.getElementById('eai-right-panel');
  const toggleRightPanelBtn = document.getElementById('toggle-right-panel-btn');
  const floatingChatFab = document.getElementById('eai-floating-chat-fab');

  const panelTabChat = document.getElementById('panel-tab-chat');
  const panelTabFeedback = document.getElementById('panel-tab-feedback');
  const panelTabNotes = document.getElementById('panel-tab-notes');
  const panelTabReport = document.getElementById('panel-tab-report');
  
  const rightContentChat = document.getElementById('right-content-chat');
  const rightContentFeedback = document.getElementById('right-content-feedback');
  const rightContentNotes = document.getElementById('right-content-notes');
  const rightContentReport = document.getElementById('right-content-report');

  const resetRightTabs = () => {
    [panelTabChat, panelTabFeedback, panelTabNotes, panelTabReport].forEach((tab) => {
      tab?.classList.remove('border-white', 'text-white');
      tab?.classList.add('border-transparent', 'text-gray-400');
    });
    [rightContentChat, rightContentFeedback, rightContentNotes, rightContentReport].forEach((pane) => {
      pane?.classList.add('hidden');
    });
  };

  panelTabChat?.addEventListener('click', () => {
    resetRightTabs();
    panelTabChat.classList.add('border-white', 'text-white');
    rightContentChat?.classList.remove('hidden');
  });

  panelTabFeedback?.addEventListener('click', () => {
    resetRightTabs();
    panelTabFeedback.classList.add('border-white', 'text-white');
    rightContentFeedback?.classList.remove('hidden');
  });

  panelTabNotes?.addEventListener('click', () => {
    resetRightTabs();
    panelTabNotes.classList.add('border-white', 'text-white');
    rightContentNotes?.classList.remove('hidden');
  });

  panelTabReport?.addEventListener('click', () => {
    resetRightTabs();
    panelTabReport.classList.add('border-white', 'text-white');
    rightContentReport?.classList.remove('hidden');
  });

  // Toggle Assistant Right Panel (Collapse / Floating FAB)
  const toggleRightPanel = (open?: boolean) => {
    const isCurrentlyOpen = rightPanel?.getAttribute('data-panel-open') === 'true';
    const shouldOpen = open !== undefined ? open : !isCurrentlyOpen;

    if (shouldOpen) {
      rightPanel?.setAttribute('data-panel-open', 'true');
      rightPanel?.classList.remove('hidden', 'lg:hidden');
      rightPanel?.classList.add('flex', 'lg:flex');
      floatingChatFab?.classList.add('hidden');
    } else {
      rightPanel?.setAttribute('data-panel-open', 'false');
      rightPanel?.classList.add('hidden', 'lg:hidden');
      rightPanel?.classList.remove('flex', 'lg:flex');
      if (window.innerWidth >= 1024) {
        floatingChatFab?.classList.remove('hidden');
      }
    }
  };

  toggleRightPanelBtn?.addEventListener('click', () => toggleRightPanel());
  floatingChatFab?.addEventListener('click', () => toggleRightPanel(true));

  // Toggle Draft Article Metadata Accordion Card
  const toggleMetaCardBtn = document.getElementById('toggle-meta-card-btn');
  const metaCardBody = document.getElementById('meta-card-body');
  const metaCardChevron = document.getElementById('meta-card-chevron');

  toggleMetaCardBtn?.addEventListener('click', () => {
    const isHidden = metaCardBody?.classList.contains('hidden');
    if (isHidden) {
      metaCardBody?.classList.remove('hidden');
      metaCardChevron?.classList.remove('rotate-180');
    } else {
      metaCardBody?.classList.add('hidden');
      metaCardChevron?.classList.add('rotate-180');
    }
  });

  // 4. MOCK REFINE ANIMATION & TOAST
  const refineBtn = document.getElementById('eai-refine-btn');
  const qualityBadge = document.getElementById('eai-quality-badge');
  const badgeHistoryQ3 = document.getElementById('badge-history-q3-tech');
  const toast = document.getElementById('eai-toast');
  const toastMessage = document.getElementById('eai-toast-message');

  const showToast = (msg: string) => {
    if (!toast || !toastMessage) return;
    toastMessage.textContent = msg;
    toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
    toast.classList.add('opacity-100', 'translate-y-0');
    setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
    }, 3000);
  };

  refineBtn?.addEventListener('click', () => {
    refineBtn.setAttribute('disabled', 'true');
    refineBtn.classList.add('opacity-50');

    // Fast refinement pulse
    setTimeout(() => {
      refineBtn.removeAttribute('disabled');
      refineBtn.classList.remove('opacity-50');

      if (qualityBadge) {
        qualityBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
        qualityBadge.textContent = 'Ready';
      }

      if (badgeHistoryQ3) {
        badgeHistoryQ3.className = 'text-[9px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400';
        badgeHistoryQ3.textContent = 'Ready';
      }

      showToast('Draft refined & Quality Gate status updated to Ready!');
    }, 700);
  });

  // 5. DRAFT HISTORY ITEM CLICK HANDLER (Short & Concise Mock Drafts)
  const draftTitle = document.getElementById('draft-title');
  const draftExcerpt = document.getElementById('draft-excerpt');
  const draftHistoryBtns = document.querySelectorAll('.draft-history-btn');

  const mockDrafts: Record<string, { title: string; excerpt: string; status: string }> = {
    'q3-tech': {
      title: 'Q3 Editorial Intelligence Review',
      excerpt: 'EAI integrates editorial constraints and automated CMS export into a unified workflow.',
      status: 'Review',
    },
    'ai-policy': {
      title: 'AI Policy & Tone Standards',
      excerpt: 'Clear boundaries for automated drafting, citation, and editorial sign-off.',
      status: 'Ready',
    },
    'cms-guide': {
      title: 'CMS Connection Architecture',
      excerpt: 'REST CMS connectors and draft-first export guarantees.',
      status: 'Blocked',
    },
  };

  draftHistoryBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const draftKey = btn.getAttribute('data-draft');
      if (!draftKey || !mockDrafts[draftKey]) return;

      draftHistoryBtns.forEach((b) => b.classList.remove('border-white/15', 'bg-white/10'));
      btn.classList.add('border-white/15', 'bg-white/10');

      const data = mockDrafts[draftKey];
      if (draftTitle) draftTitle.textContent = data.title;
      if (draftExcerpt) draftExcerpt.textContent = data.excerpt;

      if (qualityBadge) {
        if (data.status === 'Ready') {
          qualityBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
          qualityBadge.textContent = 'Ready';
        } else if (data.status === 'Blocked') {
          qualityBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30';
          qualityBadge.textContent = 'Blocked';
        } else {
          qualityBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30';
          qualityBadge.textContent = 'Needs Review';
        }
      }

      showToast(`Loaded draft: ${data.title}`);
    });
  });

  // 6. FILTER PILLS CLICK HANDLER
  const filterPills = document.querySelectorAll('.filter-pill');
  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach((p) => {
        p.classList.remove('active', 'bg-white/15', 'text-white');
        p.classList.add('bg-white/5', 'text-gray-400');
      });
      pill.classList.add('active', 'bg-white/15', 'text-white');
      pill.classList.remove('bg-white/5', 'text-gray-400');

      const filterVal = pill.getAttribute('data-filter');
      draftHistoryBtns.forEach((btn) => {
        const itemStatus = btn.getAttribute('data-status');
        if (filterVal === 'all' || itemStatus === filterVal) {
          (btn as HTMLElement).style.display = 'block';
        } else {
          (btn as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // 7. MOBILE BOTTOM NAV SWITCHER (History vs Editor vs EAI Chat)
  const mobileNavHistory = document.getElementById('mobile-nav-history');
  const mobileNavEditor = document.getElementById('mobile-nav-editor');
  const mobileNavChat = document.getElementById('mobile-nav-chat');

  const setMobileActiveTab = (target: 'history' | 'editor' | 'chat') => {
    if (window.innerWidth >= 1024) return;

    [mobileNavHistory, mobileNavEditor, mobileNavChat].forEach((btn) => {
      btn?.classList.remove('text-white', 'font-bold', 'active');
      btn?.classList.add('text-gray-400');
      const icon = btn?.querySelector('svg');
      if (icon) icon.classList.remove('text-sky-400');
    });

    // Hide all 3 panels on mobile
    sidebar?.classList.add('hidden');
    sidebar?.classList.remove('w-full');
    
    viewEditor?.classList.add('hidden');
    
    rightPanel?.classList.add('hidden');
    rightPanel?.classList.remove('w-full');

    if (target === 'history') {
      mobileNavHistory?.classList.add('text-white', 'font-bold', 'active');
      mobileNavHistory?.classList.remove('text-gray-400');
      mobileNavHistory?.querySelector('svg')?.classList.add('text-sky-400');

      if (sidebar) {
        sidebar.classList.remove('hidden');
        sidebar.classList.add('w-full');
        document.querySelectorAll('.sidebar-text').forEach((el) => el.classList.remove('hidden'));
      }
    } else if (target === 'chat') {
      mobileNavChat?.classList.add('text-white', 'font-bold', 'active');
      mobileNavChat?.classList.remove('text-gray-400');
      mobileNavChat?.querySelector('svg')?.classList.add('text-sky-400');

      if (rightPanel) {
        rightPanel.classList.remove('hidden');
        rightPanel.classList.add('w-full');
      }
    } else {
      mobileNavEditor?.classList.add('text-white', 'font-bold', 'active');
      mobileNavEditor?.classList.remove('text-gray-400');
      mobileNavEditor?.querySelector('svg')?.classList.add('text-sky-400');

      if (viewEditor) {
        viewEditor.classList.remove('hidden');
      }
    }
  };

  mobileNavHistory?.addEventListener('click', () => setMobileActiveTab('history'));
  mobileNavEditor?.addEventListener('click', () => setMobileActiveTab('editor'));
  mobileNavChat?.addEventListener('click', () => setMobileActiveTab('chat'));

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      sidebar?.classList.remove('w-full');
      rightPanel?.classList.remove('w-full');

      const isSidebarOpen = sidebar?.getAttribute('data-sidebar-open') !== 'false';
      sidebar?.classList.remove('hidden');
      if (isSidebarOpen) {
        sidebar?.classList.remove('lg:w-[60px]', 'w-[60px]');
        sidebar?.classList.add('lg:w-[240px]', 'w-[240px]');
        document.querySelectorAll('.sidebar-text').forEach((el) => el.classList.remove('hidden'));
      } else {
        sidebar?.classList.remove('lg:w-[240px]', 'w-[240px]');
        sidebar?.classList.add('lg:w-[60px]', 'w-[60px]');
        document.querySelectorAll('.sidebar-text').forEach((el) => el.classList.add('hidden'));
      }

      viewEditor?.classList.remove('hidden');

      const isPanelOpen = rightPanel?.getAttribute('data-panel-open') !== 'false';
      if (isPanelOpen) {
        rightPanel?.classList.remove('hidden', 'lg:hidden');
        rightPanel?.classList.add('flex', 'lg:flex');
        floatingChatFab?.classList.add('hidden');
      } else {
        rightPanel?.classList.add('hidden', 'lg:hidden');
        rightPanel?.classList.remove('flex', 'lg:flex');
        floatingChatFab?.classList.remove('hidden');
      }
    } else {
      setMobileActiveTab('editor');
    }
  });
</script>
