---
const stages = [
  {
    id: "refine",
    number: "01",
    label: "Refine",
    title: "Follow every editorial step as it happens.",
    description:
      "The live pipeline makes source review, rewriting, SEO preparation, quality checks, and finalization visible instead of hiding them behind a loading state.",
    image: "https://cdn.envoyou.com/landing/refinement-pipeline.png",
    alt: "EAI refinement pipeline showing source review, article rewriting, SEO metadata, quality checks, and draft finalization",
  },
  {
    id: "review",
    number: "02",
    label: "Review",
    title: "Review the decision and the publication package.",
    description:
      "Editors see what EAI improved alongside the title, slug, excerpt, description, cover alt text, and other SEO fields prepared for handoff.",
    image: "https://cdn.envoyou.com/landing/editorial-review.png",
    alt: "EAI editorial review with improvement summary and complete SEO metadata",
  },
  {
    id: "finalize",
    number: "03",
    label: "Finalize",
    title: "Keep the final draft under editorial control.",
    description:
      "Inspect the refined article, compare changes, edit the draft, or return for another refinement before choosing Export to CMS.",
    image: "https://cdn.envoyou.com/landing/final-draft.png",
    alt: "EAI final draft ready for editorial review and CMS export",
  },
  {
    id: "handoff",
    number: "04",
    label: "CMS handoff",
    title: "Send a complete draft, not a loose block of text.",
    description:
      "The connected CMS receives the article, slug, excerpt, category, and SEO settings as an editable draft ready for the publisher’s final review.",
    image: "https://cdn.envoyou.com/landing/cms-handoff.png",
    alt: "CMS admin panel containing an EAI draft with article content and SEO settings",
  },
];
---

<section id="product-preview" data-scroll-section class="overflow-x-clip">
  <div class="section">
    <div class="mb-14 grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end lg:mb-20">
      <div>
        <div class="section-label">Inside the real EAI workflow</div>
        <h2 class="section-title text-pretty">
          See the editorial decision,<br class="hidden sm:block" /> not just the rewrite.
        </h2>
      </div>
      <p class="section-subtitle lg:ml-auto lg:mt-0">
        Real product views from a single draft-to-publication journey. EAI keeps the
        work observable from refinement through CMS handoff.
      </p>
    </div>

    <!-- Desktop scrollytelling -->
    <div
      class="product-story hidden lg:grid lg:grid-cols-[minmax(0,1.65fr)_minmax(18rem,0.65fr)] lg:gap-16 xl:gap-24"
    >
      <div>
        <div class="sticky top-24">
          <div class="product-story-frame relative aspect-video overflow-hidden rounded-[1.5rem] bg-[#08111f] shadow-[0_30px_90px_rgba(15,23,42,0.2)]">
            {stages.map((stage, index) => (
              <figure
                class:list={["product-story-visual absolute inset-0", index === 0 && "is-active"]}
                data-story-visual={stage.id}
                aria-hidden={index !== 0 ? "true" : "false"}
              >
                <img
                  src={stage.image}
                  alt={stage.alt}
                  width="1920"
                  height="1080"
                  loading="lazy"
                  decoding="async"
                  class="block h-full w-full object-cover"
                />
              </figure>
            ))}
          </div>

          <div class="mt-5 flex items-center justify-between text-xs text-muted" aria-hidden="true">
            <span class="font-medium tracking-wide">Real EAI product view</span>
            <span class="font-mono tabular-nums">
              <span data-story-current>01</span> / {String(stages.length).padStart(2, "0")}
            </span>
          </div>
        </div>
      </div>

      <div class="product-story-copy">
        {stages.map((stage, index) => (
          <article
            class:list={["product-story-step relative flex min-h-[58vh] flex-col justify-center py-12", index === 0 && "is-active"]}
            data-story-step={stage.id}
            data-story-number={stage.number}
          >
            <span class="mb-8 flex items-center gap-4">
              <span class="story-step-number font-mono text-xs tabular-nums text-muted">{stage.number}</span>
              <span class="story-step-rule h-px w-10 bg-border"></span>
              <span class="story-step-label text-xs font-bold uppercase tracking-[0.16em] text-muted">
                {stage.label}
              </span>
            </span>
            <h3 class="story-step-title max-w-sm text-3xl font-bold leading-[1.14] tracking-[-0.025em] text-text text-pretty">
              {stage.title}
            </h3>
            <p class="story-step-description mt-6 max-w-sm text-base leading-7 text-muted">
              {stage.description}
            </p>
          </article>
        ))}
      </div>
    </div>

    <!-- Linear mobile presentation -->
    <div class="space-y-16 lg:hidden">
      {stages.map((stage) => (
        <article>
          <div class="overflow-hidden rounded-[1.25rem] bg-[#08111f] shadow-[0_20px_60px_rgba(15,23,42,0.16)]">
            <img
              src={stage.image}
              alt={stage.alt}
              width="1920"
              height="1080"
              loading="lazy"
              decoding="async"
              class="block aspect-video h-auto w-full"
            />
          </div>
          <div class="pt-6">
            <span class="mb-4 flex items-center gap-3">
              <span class="font-mono text-xs tabular-nums text-muted">{stage.number}</span>
              <span class="h-px w-8 bg-border"></span>
              <span class="text-xs font-bold uppercase tracking-[0.14em] text-muted">{stage.label}</span>
            </span>
            <h3 class="text-xl font-bold leading-snug tracking-[-0.02em] text-text text-pretty">{stage.title}</h3>
            <p class="mt-3 text-sm leading-6 text-muted">{stage.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const stories = document.querySelectorAll<HTMLElement>(".product-story");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  stories.forEach((story) => {
    const steps = Array.from(story.querySelectorAll<HTMLElement>("[data-story-step]"));
    const visuals = Array.from(story.querySelectorAll<HTMLElement>("[data-story-visual]"));
    const counter = story.querySelector<HTMLElement>("[data-story-current]");

    const activateStage = (activeStep: HTMLElement) => {
      const activeId = activeStep.dataset.storyStep;

      steps.forEach((step) => {
        step.classList.toggle("is-active", step === activeStep);
      });

      visuals.forEach((visual) => {
        const isActive = visual.dataset.storyVisual === activeId;
        visual.classList.toggle("is-active", isActive);
        visual.setAttribute("aria-hidden", String(!isActive));
      });

      if (counter) {
        counter.textContent = activeStep.dataset.storyNumber ?? "01";
      }
    };

    let frameRequested = false;

    const updateFromScroll = () => {
      const viewportFocus = window.innerHeight * 0.5;
      let closestStep = steps[0];
      let closestDistance = Number.POSITIVE_INFINITY;

      steps.forEach((step) => {
        const bounds = step.getBoundingClientRect();
        const stepCenter = bounds.top + bounds.height * 0.5;
        const distance = Math.abs(stepCenter - viewportFocus);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestStep = step;
        }
      });

      activateStage(closestStep);
      frameRequested = false;
    };

    const requestScrollUpdate = () => {
      if (frameRequested) return;
      frameRequested = true;
      window.requestAnimationFrame(updateFromScroll);
    };

    window.addEventListener("scroll", requestScrollUpdate, { passive: true });
    window.addEventListener("resize", requestScrollUpdate, { passive: true });
    requestScrollUpdate();

    if (prefersReducedMotion) {
      visuals.forEach((visual) => visual.classList.add("reduce-motion"));
    }
  });
</script>

<style>
  .product-story-visual {
    opacity: 0;
    transform: scale(1.012);
    transition:
      opacity 500ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .product-story-visual.is-active {
    z-index: 1;
    opacity: 1;
    transform: scale(1);
  }

  .product-story-step {
    opacity: 0.36;
    transition: opacity 280ms ease;
  }

  .product-story-step.is-active {
    opacity: 1;
  }

  .product-story-step.is-active .story-step-rule {
    width: 4rem;
    background: var(--color-primary);
  }

  .story-step-rule {
    transition:
      width 280ms ease,
      background-color 280ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-story-visual,
    .product-story-step,
    .story-step-rule {
      transition: none;
    }

    .product-story-visual {
      transform: none;
    }
  }
</style>
