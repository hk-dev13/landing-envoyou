---
// Product walkthrough — miniature pixel-perfect interactive replica of the real EAI /workspace UI
---

<section id="product-preview" data-scroll-section>
  <div class="section">
    <div class="text-center mb-14">
      <div class="section-label mx-auto">Product walkthrough · interactive preview</div>
      <h2 class="section-title">See the editorial decision, not just the rewrite.</h2>
      <p class="section-subtitle mx-auto text-center">
        This preview mirrors the real EAI workspace flow: collapsible navigation, editorial refinement, source-sensitive feedback, readiness review, and draft export.
      </p>
    </div>

    <!-- Tabs selector -->
    <div class="flex justify-center mb-10">
      <div class="inline-flex p-1.5 rounded-2xl bg-surface-soft border border-border shadow-sm">
        <button
          id="tab-btn-eai"
          class="tab-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 cursor-pointer active"
          data-tab="eai"
        >
          <svg class="w-4 h-4 text-primary" viewBox="0 0 600 600" fill="currentColor">
            <path d="M289 67v56h22V10h-22zm89 11-21 53q0 2 9 5l10 4 1-2 21-52c22-56 21-51 15-53l-10-4-5-2zM187 33l-10 4 44 104 19-8-44-104zM95 95l-7 8 40 40 39 40 8-8 8-8-40-39-40-40zm362 33-39 39 7 8 8 8 40-40 39-40-7-8-8-7zm53 71-51 22 8 19 103-43 1-1-9-19zM34 184l-4 9-3 9 104 41q2 0 5-9l4-10-3-1-51-21-50-20zM10 300v11h113v-22H10zm279 0v11h301v-22H289zm178 58-4 10-3 8 3 1 51 21 50 19c1 1 9-18 9-19zM92 377l-51 22-12 5 9 19 103-44-9-19zm36 80-39 40 15 15 40-39 39-40-7-7-8-8zm298-31-7 7 39 40 40 39 15-15-79-79zm-56 37-9 4 20 48 22 51 1 5 20-9-45-103zm-146 0-40 101 19 9 41-104q0-2-9-5l-10-4zm66 71v56h22V477h-22z"/>
          </svg>
          EAI Workspace
        </button>
        <button
          id="tab-btn-blog"
          class="tab-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 cursor-pointer"
          data-tab="blog"
        >
          <svg class="w-4 h-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
          CMS Export (E-Blog)
        </button>
      </div>
    </div>

    <!-- Preview Windows Container -->
    <div class="relative max-w-6xl mx-auto">
      <div class="relative bg-surface-soft rounded-2xl min-h-[640px] flex flex-col overflow-hidden shadow-2xl border border-border">
        
        <!-- Window Titlebar -->
        <div class="flex items-center justify-between px-5 py-3 border-b border-border bg-surface-soft/80 select-none">
          <div class="flex items-center gap-2">
            <span class="w-3.5 h-3.5 rounded-full bg-rose-500/80"></span>
            <span class="w-3.5 h-3.5 rounded-full bg-amber-500/80"></span>
            <span class="w-3.5 h-3.5 rounded-full bg-emerald-500/80"></span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-surface border border-border text-xs font-mono text-muted">
            <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span id="window-title">https://eai.envoyou.com/workspace</span>
          </div>
          <div class="w-12"></div>
        </div>

        <!-- TAB 1: EAI WORKSPACE INTERACTIVE APP -->
        <div id="tab-content-eai" class="tab-pane active flex flex-1 flex-col lg:flex-row min-w-0 bg-[#101114] dark:bg-[#101114] text-[#f7f8f8] relative overflow-hidden font-sans">
          
          <!-- 1. LEFT SIDEBAR PANEL (Exact EAI AppSidebarShell Layout) -->
          <aside 
            id="eai-sidebar" 
            class="hidden flex flex-col lg:flex border-none bg-[#101114] transition-all duration-300 ease-in-out shrink-0 w-full lg:w-[240px]"
            data-sidebar-open="true"
          >
            <!-- Top Section: Brand & Sidebar Toggle -->
            <div class="p-3 flex items-center justify-between gap-2 border-b border-white/5">
              <div class="sidebar-text flex items-center gap-2.5 min-w-0 overflow-hidden">
                <div class="w-7 h-7 flex items-center justify-center text-white shrink-0">
                  <!-- Authentic EAI SVG Logo -->
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="24" height="24">
                    <path fill="currentColor" stroke="currentColor" stroke-width="20" stroke-linejoin="round" stroke-linecap="round" d="M289 67v56h22V10h-22zm89 11-21 53q0 2 9 5l10 4 1-2 21-52c22-56 21-51 15-53l-10-4-5-2zM187 33l-10 4 44 104 19-8-44-104zM95 95l-7 8 40 40 39 40 8-8 8-8-40-39-40-40zm362 33-39 39 7 8 8 8 40-40 39-40-7-8-8-7zm53 71-51 22 8 19 103-43 1-1-9-19zM34 184l-4 9-3 9 104 41q2 0 5-9l4-10-3-1-51-21-50-20zM10 300v11h113v-22H10zm279 0v11h301v-22H289zm178 58-4 10-3 8 3 1 51 21 50 19c1 1 9-18 9-19zM92 377l-51 22-12 5 9 19 103-44-9-19zm36 80-39 40 15 15 40-39 39-40-7-7-8-8zm298-31-7 7 39 40 40 39 15-15-79-79zm-56 37-9 4 20 48 22 51 1 5 20-9-45-103zm-146 0-40 101 19 9 41-104q0-2-9-5l-10-4zm66 71v56h22V477h-22z"/>
                  </svg>
                </div>
                <div class="flex flex-col min-w-0">
                  <span class="text-xs font-bold tracking-tight text-white truncate">Envoyou AI</span>
                  <span class="text-[8.5px] text-gray-400 font-semibold tracking-wider uppercase truncate">EDITORIAL INTELLIGENCE</span>
                </div>
              </div>

              <!-- Sidebar Toggle Button (PanelLeft) -->
              <button 
                id="sidebar-toggle-btn"
                type="button"
                class="p-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/10 transition-all cursor-pointer flex items-center justify-center shrink-0"
                title="Hide / Expand Sidebar"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <line x1="9" y1="3" x2="9" y2="21"/>
                </svg>
              </button>
            </div>

            <!-- Organization Switcher Pill -->
            <div class="p-2.5 border-b border-white/5 sidebar-text">
              <div class="flex items-center justify-between px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs">
                <div class="flex items-center gap-1.5 truncate">
                  <svg class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                  <span class="font-semibold text-white truncate">Envoyou</span>
                </div>
                <span class="text-[9px] font-extrabold px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 uppercase tracking-wide">TEAM</span>
              </div>
            </div>

            <!-- Navigation Menu Items -->
            <div class="p-2 space-y-1">
              <button
                id="nav-item-editor"
                class="nav-tab-btn w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-white/10 text-white"
                data-target="editor"
              >
                <svg class="w-4 h-4 shrink-0 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <span class="sidebar-text truncate">Editor</span>
              </button>
              <button
                id="nav-item-dashboard"
                class="nav-tab-btn w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-white/5 transition-all cursor-pointer"
                data-target="dashboard"
              >
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                <span class="sidebar-text truncate">Dashboard</span>
              </button>
            </div>

            <!-- + New Article Button & Search/Filter Section -->
            <div class="p-2.5 border-t border-white/5 sidebar-text space-y-2.5">
              <button 
                id="btn-new-article"
                class="w-full py-2 px-3 rounded-full bg-white text-black text-xs font-bold hover:bg-gray-200 transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-sm"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                New Article
              </button>

              <div class="relative">
                <input 
                  type="text" 
                  placeholder="Search drafts..." 
                  class="w-full px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-white/20" 
                />
              </div>

              <!-- Filter Pills -->
              <div class="flex items-center justify-between gap-1 pt-1">
                <button class="filter-pill active px-2 py-0.5 rounded-full text-[10px] font-bold bg-white/15 text-white" data-filter="all">All</button>
                <button class="filter-pill px-2 py-0.5 rounded-full text-[10px] font-bold bg-white/5 text-gray-400 hover:text-white" data-filter="ready">Ready</button>
                <button class="filter-pill px-2 py-0.5 rounded-full text-[10px] font-bold bg-white/5 text-gray-400 hover:text-white" data-filter="review">Review</button>
                <button class="filter-pill px-2 py-0.5 rounded-full text-[10px] font-bold bg-white/5 text-gray-400 hover:text-white" data-filter="blocked">Blocked</button>
              </div>
            </div>

            <!-- History Draft List -->
            <div class="sidebar-text flex-1 overflow-y-auto px-2 space-y-1">
              <!-- Draft Item 1 -->
              <button
                class="draft-history-btn w-full text-left p-2 rounded-xl border border-white/15 bg-white/10 transition-all cursor-pointer group active"
                data-draft="q3-tech"
                data-status="review"
              >
                <p class="text-xs font-semibold text-white group-hover:text-sky-400 truncate">Q3 Editorial Review</p>
                <div class="flex items-center justify-between mt-1">
                  <span class="text-[10px] text-gray-400">2 mins ago</span>
                  <span id="badge-history-q3-tech" class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300">Review</span>
                </div>
              </button>

              <!-- Draft Item 2 -->
              <button
                class="draft-history-btn w-full text-left p-2 rounded-xl border border-transparent hover:border-white/10 hover:bg-white/5 transition-all cursor-pointer group"
                data-draft="ai-policy"
                data-status="ready"
              >
                <p class="text-xs font-semibold text-gray-300 group-hover:text-white truncate">AI Policy & Brand Tone</p>
                <div class="flex items-center justify-between mt-1">
                  <span class="text-[10px] text-gray-500">1 hour ago</span>
                  <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400">Ready</span>
                </div>
              </button>

              <!-- Draft Item 3 -->
              <button
                class="draft-history-btn w-full text-left p-2 rounded-xl border border-transparent hover:border-white/10 hover:bg-white/5 transition-all cursor-pointer group"
                data-draft="cms-guide"
                data-status="blocked"
              >
                <p class="text-xs font-semibold text-gray-300 group-hover:text-white truncate">CMS Connection Guide</p>
                <div class="flex items-center justify-between mt-1">
                  <span class="text-[10px] text-gray-500">Yesterday</span>
                  <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-400">Blocked</span>
                </div>
              </button>
            </div>

            <!-- Sidebar Bottom User & Settings Footer -->
            <div class="p-2.5 border-t border-white/5 sidebar-text space-y-1">
              <button class="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs text-gray-400 hover:text-white hover:bg-white/5 transition-all">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span>Settings</span>
              </button>
              
              <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-white/5 bg-white/5 mt-1">
                <div class="w-5 h-5 rounded-full bg-gradient-to-tr from-sky-400 to-indigo-500 text-[10px] font-bold text-white flex items-center justify-center">HK</div>
                <div class="flex flex-col min-w-0">
                  <span class="text-[11px] font-bold text-white leading-tight truncate">Husni Kusuma</span>
                  <span class="text-[9px] text-gray-400 truncate">husnikusuma@envoyou.com</span>
                </div>
              </div>
            </div>
          </aside>

          <!-- 2. MAIN WORKSPACE VIEW CONTAINER -->
          <div class="flex-1 flex flex-col min-w-0 bg-[#101114]">
            
            <!-- VIEW A: EDITOR VIEW -->
            <div id="view-editor" class="workspace-view active flex-1 flex flex-col lg:flex-row min-w-0 relative">
              <!-- Center Column: Editor Canvas (Floating Inset Panel) -->
              <div class="flex-1 flex flex-col min-w-0 relative bg-[#0c0d0e]/95 backdrop-blur-md shadow-2xl m-0 lg:m-2 rounded-none lg:rounded-2xl border border-white/10 overflow-hidden">
                
                <!-- Workspace Top Breadcrumb & Header Action Bar -->
                <div class="flex items-center justify-between gap-2 px-4 py-2.5 border-b border-white/10 bg-[#080809]">
                  <div class="flex items-center gap-1.5 text-xs text-gray-400 min-w-0 truncate">
                    <span class="font-bold text-white truncate">Workspace</span>
                    <span>/</span>
                    <span class="text-gray-300 truncate">Draft Article</span>
                  </div>

                  <div class="flex items-center gap-2 shrink-0">
                    <button class="hidden md:flex text-xs text-gray-400 hover:text-white transition-colors items-center gap-1">
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2"/></svg>
                      What's New
                    </button>
                    <button class="hidden md:flex text-xs text-gray-400 hover:text-white transition-colors items-center gap-1">
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>
                      Undo
                    </button>

                    <!-- Cloud Icon -->
                    <button class="p-1 text-gray-400 hover:text-white transition-colors cursor-pointer" title="Save to Cloud">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9z"/></svg>
                    </button>
                    
                    <!-- Publish Ready Dropdown Pill -->
                    <button class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/15 text-white text-xs font-semibold flex items-center gap-1 border border-white/10 cursor-pointer">
                      <svg class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.71 1.26-1.5 1.5-2.5l-4.5-4.5c-1 1-1.79 1.79-2.5 2.5z"/><path d="M12 15l-3-3 7.5-7.5c1.5-1.5 4-1.5 4 0s0 2.5-1.5 4L12 15z"/></svg>
                      <span class="hidden sm:inline">Publish Ready</span>
                      <svg class="w-3 h-3 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>

                    <!-- Refine Draft Action Button (Wand Icon) -->
                    <button 
                      id="eai-refine-btn"
                      type="button"
                      class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/20 text-white text-xs font-semibold border border-white/20 transition-all flex items-center gap-1.5 cursor-pointer active:scale-95"
                      title="Refine Draft"
                    >
                      <svg class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 3v3m0 12v3M3 12h3m12 0h3m-3.5-6.5l-2 2m-7 7l-2 2m11 0l-2-2m-7-7l-2-2"/></svg>
                      <span class="hidden sm:inline">Refine Draft</span>
                    </button>
                  </div>
                </div>

                <!-- Secondary Tabs & Collapsible Metadata Accordion Card -->
                <div class="px-4 py-3 border-b border-white/5 bg-[#0c0d0e] space-y-3 text-xs">
                  <!-- Draft vs Refined Draft Tabs -->
                  <div class="flex items-center gap-4 border-b border-white/10 pb-2">
                    <button id="btn-tab-draft" class="text-white font-bold flex items-center gap-1.5 relative py-0.5 cursor-pointer">
                      <svg class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      <span>Draft</span>
                      <span class="absolute bottom-[-9px] left-0 right-0 h-[2px] bg-white rounded-full"></span>
                    </button>
                    <button id="btn-tab-refined" class="text-gray-400 hover:text-white font-medium flex items-center gap-1.5 py-0.5 cursor-pointer">
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                      <span>Refined Draft</span>
                    </button>
                  </div>

                  <!-- Collapsible Draft Article Card (Matching App Screenshot) -->
                  <div class="p-3 rounded-2xl bg-white/[0.03] border border-white/10 space-y-2.5">
                    <!-- Card Header -->
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-2">
                        <svg class="w-3.5 h-3.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        <span class="font-bold text-white text-xs">Draft Article</span>
                      </div>
                      <div class="flex items-center gap-2 text-gray-400">
                        <button id="toggle-meta-card-btn" class="hover:text-white transition-colors cursor-pointer" title="Toggle Card">
                          <svg id="meta-card-chevron" class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
                        </button>
                        <button class="hover:text-white transition-colors cursor-pointer" title="Duplicate Draft">
                          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        </button>
                        <button class="hover:text-rose-400 transition-colors cursor-pointer" title="Delete Draft">
                          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </button>
                      </div>
                    </div>

                    <!-- Stacked Dropdowns & Inputs -->
                    <div id="meta-card-body" class="space-y-2 pt-1 transition-all duration-200">
                      <div class="relative">
                        <select class="w-full px-3 py-2 pr-8 rounded-xl bg-[#16181d] border border-white/10 text-xs text-gray-200 focus:outline-none focus:border-white/20 appearance-none cursor-pointer">
                          <option class="bg-[#16181d] text-gray-200 py-1">Technology & AI</option>
                          <option class="bg-[#16181d] text-gray-200 py-1">News & Trend Analysis</option>
                          <option class="bg-[#16181d] text-gray-200 py-1">Business & Strategy</option>
                        </select>
                        <svg class="w-3.5 h-3.5 text-gray-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                      </div>

                      <div class="relative">
                        <select class="w-full px-3 py-2 pr-8 rounded-xl bg-[#16181d] border border-white/10 text-xs text-gray-200 focus:outline-none focus:border-white/20 appearance-none cursor-pointer">
                          <option class="bg-[#16181d] text-gray-200 py-1">News & Trend Analysis</option>
                          <option class="bg-[#16181d] text-gray-200 py-1">Editorial Opinion</option>
