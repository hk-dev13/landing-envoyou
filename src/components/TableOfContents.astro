---
export interface TOCItem {
  id: string;
  title: string;
}

export interface Props {
  items: TOCItem[];
}

const { items } = Astro.props;
---

<!-- Desktop Sticky TOC Sidebar (Borderless, Minimal typography navigation) -->
<aside class="hidden lg:block sticky top-28 self-start max-h-[calc(100vh-140px)] overflow-y-auto custom-scrollbar text-xs">
  <div class="py-1">
    <p class="font-bold text-text uppercase tracking-widest text-[10px] mb-3 text-muted/70">
      On this page
    </p>
    <nav aria-label="Table of contents" class="space-y-1 border-l border-border/80">
      {items.map((item) => (
        <a
          href={`#${item.id}`}
          data-toc-id={item.id}
          class="toc-link block text-muted hover:text-text pl-3.5 py-1 border-l-2 border-transparent -ml-px transition-all duration-150 leading-relaxed"
          title={item.title}
        >
          {item.title}
        </a>
      ))}
    </nav>
  </div>
</aside>

<!-- Mobile Floating TOC Trigger & Bottom Sheet (Option B) -->
<div class="lg:hidden">
  <!-- Trigger Button Floating Bottom Center (Avoid collision with Back to Top at bottom-right) -->
  <button
    id="mobile-toc-trigger"
    type="button"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 flex items-center gap-2 px-4 py-2.5 rounded-full bg-surface/95 hover:bg-surface border border-border/80 shadow-2xl backdrop-blur-md text-xs font-bold text-text transition-all duration-200 active:scale-95 whitespace-nowrap"
    aria-label="Open Table of Contents"
    aria-expanded="false"
  >
    <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="8" y1="6" x2="21" y2="6"></line>
      <line x1="8" y1="12" x2="21" y2="12"></line>
      <line x1="8" y1="18" x2="21" y2="18"></line>
      <line x1="3" y1="6" x2="3.01" y2="6"></line>
      <line x1="3" y1="12" x2="3.01" y2="12"></line>
      <line x1="3" y1="18" x2="3.01" y2="18"></line>
    </svg>
    <span>On this page</span>
    <span class="px-1.5 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-extrabold">
      {items.length}
    </span>
  </button>

  <!-- Bottom Sheet Drawer Overlay & Container -->
  <div
    id="mobile-toc-overlay"
    class="fixed inset-0 z-50 pointer-events-none opacity-0 transition-opacity duration-300"
  >
    <!-- Backdrop -->
    <div
      id="mobile-toc-backdrop"
      class="absolute inset-0 bg-black/60 backdrop-blur-sm"
    ></div>

    <!-- Drawer Panel -->
    <div
      id="mobile-toc-drawer"
      class="absolute bottom-0 inset-x-0 bg-surface border-t border-border rounded-t-3xl p-6 max-h-[75vh] flex flex-col translate-y-full transition-transform duration-300 shadow-2xl pointer-events-auto"
    >
      <div class="flex items-center justify-between pb-4 border-b border-border/60 mb-3 shrink-0">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          <h3 class="text-sm font-bold text-text">On this page</h3>
        </div>
        <button
          id="mobile-toc-close"
          type="button"
          class="p-1.5 rounded-lg text-muted hover:text-text hover:bg-surface-soft transition-colors"
          aria-label="Close Table of Contents"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav aria-label="Table of contents (mobile)" class="overflow-y-auto space-y-1 text-xs py-1">
        {items.map((item) => (
          <a
            href={`#${item.id}`}
            class="mobile-toc-item block py-2.5 px-3 rounded-lg text-muted hover:text-text hover:bg-surface-soft font-medium transition-colors border-l-2 border-transparent"
            data-mobile-toc-id={item.id}
          >
            {item.title}
          </a>
        ))}
      </nav>
    </div>
  </div>
</div>

<script>
  function setupTOC() {
    // Desktop active indicator
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-id]');
    const mobileTocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-toc-id]');

    const trigger = document.getElementById('mobile-toc-trigger');
    const overlay = document.getElementById('mobile-toc-overlay');
    const backdrop = document.getElementById('mobile-toc-backdrop');
    const drawer = document.getElementById('mobile-toc-drawer');
    const closeBtn = document.getElementById('mobile-toc-close');

    function openDrawer() {
      overlay?.classList.remove('pointer-events-none', 'opacity-0');
      overlay?.classList.add('pointer-events-auto', 'opacity-100');
      drawer?.classList.remove('translate-y-full');
      drawer?.classList.add('translate-y-0');
      trigger?.setAttribute('aria-expanded', 'true');
    }

    function closeDrawer() {
      overlay?.classList.add('pointer-events-none', 'opacity-0');
      overlay?.classList.remove('pointer-events-auto', 'opacity-100');
      drawer?.classList.add('translate-y-full');
      drawer?.classList.remove('translate-y-0');
      trigger?.setAttribute('aria-expanded', 'false');
    }

    trigger?.addEventListener('click', openDrawer);
    backdrop?.addEventListener('click', closeDrawer);
    closeBtn?.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });

    mobileTocLinks.forEach((link) => {
      link.addEventListener('click', () => {
        closeDrawer();
      });
    });

    // IntersectionObserver for active heading sync
    const allLinks = Array.from(tocLinks);
    if (!allLinks.length) return;

    const sections = allLinks
      .map((link) => {
        const id = link.getAttribute('data-toc-id');
        return id ? document.getElementById(id) : null;
      })
      .filter((section): section is HTMLElement => section !== null);

    if (!sections.length) return;

    let activeId = '';

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          activeId = entry.target.id;
        }
      });

      tocLinks.forEach((link) => {
        const id = link.getAttribute('data-toc-id');
        if (id === activeId) {
          link.classList.add('text-primary', 'font-semibold', 'border-primary');
          link.classList.remove('text-muted', 'border-transparent');
        } else {
          link.classList.remove('text-primary', 'font-semibold', 'border-primary');
          link.classList.add('text-muted', 'border-transparent');
        }
      });

      mobileTocLinks.forEach((link) => {
        const id = link.getAttribute('data-mobile-toc-id');
        if (id === activeId) {
          link.classList.add('text-primary', 'font-semibold', 'bg-surface-soft', 'border-primary');
          link.classList.remove('text-muted', 'border-transparent');
        } else {
          link.classList.remove('text-primary', 'font-semibold', 'bg-surface-soft', 'border-primary');
          link.classList.add('text-muted', 'border-transparent');
        }
      });
    }, {
      root: null,
      rootMargin: '-15% 0px -65% 0px',
      threshold: 0,
    });

    sections.forEach((section) => observer.observe(section));
  }

  setupTOC();
  document.addEventListener('astro:page-load', setupTOC);
</script>
