---
export interface TOCItem {
  id: string;
  title: string;
}

export interface Props {
  items: TOCItem[];
}

const { items } = Astro.props;
---

<!-- Desktop Sticky TOC Sidebar (Borderless, Minimal typography navigation) -->
<aside class="hidden lg:block sticky top-28 self-start max-h-[calc(100vh-140px)] overflow-y-auto custom-scrollbar text-xs">
  <div class="py-1">
    <p class="font-bold text-text uppercase tracking-widest text-[10px] mb-3 text-muted/70">
      On this page
    </p>
    <nav aria-label="Table of contents" class="space-y-1 border-l border-border/80">
      {items.map((item) => (
        <a
          href={`#${item.id}`}
          data-toc-id={item.id}
          class="toc-link block text-muted hover:text-text pl-3.5 py-1 border-l-2 border-transparent -ml-px transition-all duration-150 leading-relaxed"
          title={item.title}
        >
          {item.title}
        </a>
      ))}
    </nav>
  </div>
</aside>

<!-- Mobile Collapsible TOC -->
<details class="lg:hidden mb-8 rounded-xl border border-border bg-surface-soft/40 p-3.5 transition-all text-xs">
  <summary class="flex items-center justify-between font-semibold text-text cursor-pointer select-none">
    <span class="flex items-center gap-2">
      <svg class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="8" y1="6" x2="21" y2="6"></line>
        <line x1="8" y1="12" x2="21" y2="12"></line>
        <line x1="8" y1="18" x2="21" y2="18"></line>
        <line x1="3" y1="6" x2="3.01" y2="6"></line>
        <line x1="3" y1="12" x2="3.01" y2="12"></line>
        <line x1="3" y1="18" x2="3.01" y2="18"></line>
      </svg>
      Table of Contents ({items.length} sections)
    </span>
    <svg class="w-3.5 h-3.5 text-muted transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </summary>
  <nav aria-label="Table of contents (mobile)" class="mt-3 pt-2.5 border-t border-border/70 space-y-1">
    {items.map((item) => (
      <a
        href={`#${item.id}`}
        class="block text-muted hover:text-primary py-1 px-2 rounded hover:bg-surface transition-colors"
      >
        {item.title}
      </a>
    ))}
  </nav>
</details>

<script>
  function setupTOCIntersectionObserver() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-id]');
    if (!tocLinks.length) return;

    const sections = Array.from(tocLinks)
      .map((link) => {
        const id = link.getAttribute('data-toc-id');
        return id ? document.getElementById(id) : null;
      })
      .filter((section): section is HTMLElement => section !== null);

    if (!sections.length) return;

    let activeId = '';

    const observerOptions = {
      root: null,
      rootMargin: '-15% 0px -65% 0px',
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          activeId = entry.target.id;
        }
      });

      tocLinks.forEach((link) => {
        const id = link.getAttribute('data-toc-id');
        if (id === activeId) {
          link.classList.add('text-primary', 'font-semibold', 'border-primary');
          link.classList.remove('text-muted', 'border-transparent');
        } else {
          link.classList.remove('text-primary', 'font-semibold', 'border-primary');
          link.classList.add('text-muted', 'border-transparent');
        }
      });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));
  }

  setupTOCIntersectionObserver();
  document.addEventListener('astro:page-load', setupTOCIntersectionObserver);
</script>
