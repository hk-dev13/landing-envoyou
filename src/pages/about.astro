---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const workflow = [
  { number: "01", label: "Research" },
  { number: "02", label: "Draft" },
  { number: "03", label: "Refine" },
  { number: "04", label: "Verify" },
  { number: "05", label: "Package" },
  { number: "06", label: "Publish" },
];

const principles = [
  {
    number: "01",
    eyebrow: "Publication readiness",
    title: "A convincing draft is not the same as a publishable article.",
    description:
      "AI drafts can look polished while still containing weak structure, generic insight, unsupported claims, mismatched headlines, or familiar AI patterns. EAI treats those issues as editorial risks, not cosmetic details.",
    outcome:
      "The system acts as a gatekeeper. It can help write, but it cannot declare its own work trustworthy without review.",
  },
  {
    number: "02",
    eyebrow: "Editorial integrity",
    title: "A second AI opinion does not make a claim true.",
    description:
      "EAI connects source fidelity, factual guardrails, deterministic checks, and the Quality Gate to the same article state. Numbers, names, entities, claims, and provenance stay visible throughout review.",
    outcome:
      "When a check fails, the article remains blocked. The right response is to improve the checker or resolve the evidence, not lower the standard.",
  },
  {
    number: "03",
    eyebrow: "Editorial focus",
    title: "Editors should spend time on decisions, not repetitive assembly.",
    description:
      "Claim review, rewriting, search engine optimization (SEO) titles, slugs, excerpts, metadata, image guidance, internal links, and content management system (CMS) preparation belong to one controlled workflow.",
    outcome:
      "The system handles repeatable work while the editor retains the final judgment and publication action.",
  },
];

const ecosystem = [
  {
    label: "Company and product",
    title: "envoyou.com",
    description:
      "The public home for Envoyou, product guidance, release updates, methodology, and company context.",
    href: "https://www.envoyou.com",
    external: false,
  },
  {
    label: "Editorial workspace",
    title: "eai.envoyou.com",
    description:
      "The Editorial Intelligence workspace for drafting, refinement, source-sensitive review, Quality Gate checks, and CMS handoff.",
    href: "https://eai.envoyou.com/login",
    external: true,
  },
  {
    label: "Publishing practice",
    title: "blog.envoyou.com",
    description:
      "The publication where Envoyou applies its editorial standards to real articles and a public archive.",
    href: "https://blog.envoyou.com",
    external: true,
  },
];
---

<BaseLayout
  title="Why EAI Exists | About Envoyou"
  description="EAI exists because generating text is inexpensive, while producing content that editors can trust, control, and publish remains an editorial problem."
>
  <Navbar />

  <main class="min-h-screen overflow-x-clip bg-bg pt-24">
    <section class="relative mx-auto max-w-[90rem] px-6 pb-24 pt-16 sm:pt-24">
      <div
        class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_0%,var(--color-hero-glow)_0%,transparent_42%),radial-gradient(circle_at_85%_15%,var(--color-hero-glow-2)_0%,transparent_38%)]"
        aria-hidden="true"
      ></div>

      <div class="mx-auto max-w-5xl text-center">
        <div class="section-label mx-auto">Why EAI exists</div>
        <h1 class="text-pretty text-4xl font-black leading-[1.02] tracking-[-0.04em] text-text sm:text-6xl lg:text-7xl">
          Generating text is cheap.
          <span class="block text-primary">Publishing with confidence is not.</span>
        </h1>
        <p class="mx-auto mt-7 max-w-3xl text-pretty text-lg leading-8 text-muted">
          Envoyou Editorial Intelligence (EAI) exists because an artificial intelligence (AI) draft is only the beginning. Editors still need to decide whether the article is accurate, supported by sources, aligned with the publication, and ready to enter a public archive.
        </p>

        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a
            href="https://eai.envoyou.com/login"
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="eai_outbound_clicked"
            data-analytics-location="about_hero"
            class="btn-primary"
          >
            Open EAI
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M7 17L17 7M17 7H7M17 7v10"></path>
            </svg>
          </a>
          <a href="/ai-editorial-workspace/" class="btn-secondary">
            Explore the workflow
          </a>
        </div>
      </div>
    </section>

    <section class="border-t border-border/60">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:py-28">
        <div class="lg:sticky lg:top-28">
          <span class="text-xs font-bold uppercase tracking-[0.16em] text-muted">The root problem</span>
          <h2 class="mt-4 max-w-md text-pretty text-3xl font-extrabold leading-tight tracking-[-0.03em] text-text sm:text-4xl">
            The work does not end when the draft appears.
          </h2>
        </div>

        <div class="space-y-8">
          <p class="text-pretty text-xl leading-9 text-text">
            While building and operating Envoyou, I kept encountering the same gap. A model could produce text in seconds, but the editorial work that followed remained long and consequential.
          </p>

          <blockquote class="border-l-2 border-primary pl-6 text-pretty text-lg font-semibold leading-8 text-text">
            Is the article accurate? Are its claims supported? Does the voice fit the publication? Is the insight specific? Is the SEO package complete? Is this ready to publish?
          </blockquote>

          <p class="max-w-2xl text-base leading-7 text-muted">
            General AI tools can help produce a draft. They do not replace the editorial process required to trust that draft. EAI was built to organize that process and keep the evidence, decisions, and publication context connected.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-border/60 bg-surface-soft/40">
      <div class="mx-auto max-w-6xl px-6 py-20 lg:py-28">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <div class="section-label">The product thesis</div>
            <h2 class="max-w-xl text-pretty text-3xl font-extrabold leading-tight tracking-[-0.03em] text-text sm:text-4xl">
              EAI is an editorial system, not another AI writer.
            </h2>
          </div>
          <p class="max-w-2xl text-base leading-7 text-muted lg:ml-auto">
            The product has repeatedly moved away from prompt, generate, and copy-paste. Editorial Intelligence is a better description because the system supports the complete path from working material to controlled publication.
          </p>
        </div>

        <ol class="mt-14 grid grid-cols-2 overflow-hidden rounded-3xl border border-border bg-surface sm:grid-cols-3 lg:grid-cols-6">
          {workflow.map((step, index) => (
            <li class="relative border-b border-r border-border p-5 last:border-r-0 sm:p-6 lg:border-b-0">
              <span class="font-mono text-xs tabular-nums text-muted">{step.number}</span>
              <span class="mt-8 block text-sm font-bold text-text">{step.label}</span>
              {index < workflow.length - 1 && (
                <svg class="absolute right-3 top-1/2 hidden h-4 w-4 -translate-y-1/2 text-muted lg:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              )}
            </li>
          ))}
        </ol>

        <div class="mt-6 flex items-center justify-center gap-3 text-sm text-muted">
          <span class="line-through decoration-red-500/70">Prompt → Generate → Copy-paste</span>
          <span aria-hidden="true">≠</span>
          <span class="font-semibold text-text">Editorial Intelligence</span>
        </div>
      </div>
    </section>

    <section class="border-t border-border/60">
      <div class="mx-auto max-w-6xl px-6 py-20 lg:py-28">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <div class="section-label mx-auto">What EAI protects</div>
          <h2 class="text-pretty text-3xl font-extrabold leading-tight tracking-[-0.03em] text-text sm:text-4xl">
            Three principles shape every product decision.
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-muted">
            Features can change. These editorial principles define why the product exists and what it must never trade away.
          </p>
        </div>

        <div class="divide-y divide-border border-y border-border">
          {principles.map((principle) => (
            <article class="grid gap-6 py-10 sm:py-14 lg:grid-cols-[5rem_0.75fr_1.25fr] lg:gap-12">
              <span class="font-mono text-sm tabular-nums text-muted">{principle.number}</span>
              <div>
                <span class="text-xs font-bold uppercase tracking-[0.14em] text-muted">{principle.eyebrow}</span>
                <h3 class="mt-4 max-w-md text-pretty text-2xl font-bold leading-snug tracking-[-0.02em] text-text">
                  {principle.title}
                </h3>
              </div>
              <div class="max-w-xl">
                <p class="text-base leading-7 text-muted">{principle.description}</p>
                <p class="mt-5 border-l-2 border-primary pl-5 text-sm font-semibold leading-6 text-text">
                  {principle.outcome}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-border/60 bg-[#0b0c0e] text-white">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:py-28">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">A stricter definition of done</span>
          <h2 class="mt-4 max-w-lg text-pretty text-3xl font-extrabold leading-tight tracking-[-0.03em] sm:text-4xl">
            Worthy of a public archive.
          </h2>
        </div>

        <div>
          <p class="text-pretty text-xl leading-9 text-slate-200">
            Building the Envoyou Blog made the goal clearer. I was never interested in producing the largest possible volume of content. I wanted to understand how to create work that deserves a permanent place in a publication.
          </p>
          <div class="mt-8 rounded-2xl border border-white/10 bg-white/[0.04] p-6 sm:p-8">
            <span class="text-xs font-bold uppercase tracking-[0.14em] text-sky-400">The publication criterion</span>
            <p class="mt-4 text-pretty text-2xl font-bold leading-snug">
              Would I trust this article enough to press Publish?
            </p>
          </div>
          <p class="mt-7 max-w-2xl text-base leading-7 text-slate-400">
            Editorial profiles, source-sensitive review, human approval, readiness verdicts, deterministic checks, and CMS handoff all serve that criterion. The question is not whether AI can write an article. The question is whether the publication can stand behind it.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-border/60">
      <div class="mx-auto max-w-5xl px-6 py-20 lg:py-28">
        <div class="grid gap-10 lg:grid-cols-[0.65fr_1.35fr] lg:items-start">
          <div>
            <div class="section-label">Founder perspective</div>
            <h2 class="text-3xl font-extrabold tracking-[-0.03em] text-text">Husni Kusuma</h2>
            <p class="mt-2 text-sm font-semibold text-muted">Founder and lead developer</p>

            <div class="mt-6 flex items-center gap-4">
              <a
                href="https://github.com/hk-dev13"
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted transition-colors hover:text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                aria-label="Husni Kusuma on GitHub"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5A4 4 0 0 0 9 18v4"></path>
                  <path d="M9 18c-4.5 2-5-2-7-2"></path>
                </svg>
              </a>
              <a
                href="https://www.linkedin.com/in/husni-kusuma"
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted transition-colors hover:text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                aria-label="Husni Kusuma on LinkedIn"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </a>
            </div>
          </div>

          <div class="space-y-6 text-lg leading-8 text-muted">
            <p>
              I built EAI after experiencing the work that begins when an AI draft ends. Every recent refactor still follows the same reason: source fidelity, Quality Gate checks, publication metadata, CMS export, and editorial onboarding all protect the path to publication.
            </p>
            <p>
              Generating text has become inexpensive. Producing content that people can trust, editors can control, and publications can confidently release remains an editorial problem.
            </p>
            <p class="border-l-2 border-primary pl-6 font-semibold text-text">
              EAI does not replace the editor. It handles the work a system should handle, so the editor can focus on the judgment only a person should make.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-border/60 bg-surface-soft/30">
      <div class="mx-auto max-w-6xl px-6 py-20 lg:py-28">
        <div class="mx-auto mb-14 max-w-2xl text-center">
          <div class="section-label mx-auto">The Envoyou ecosystem</div>
          <h2 class="text-pretty text-3xl font-extrabold tracking-[-0.03em] text-text sm:text-4xl">
            Product, practice, and publication stay connected.
          </h2>
        </div>

        <div class="grid gap-5 md:grid-cols-3">
          {ecosystem.map((item) => (
            <a
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              class="group rounded-3xl border border-border bg-surface p-7 no-underline transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
            >
              <span class="text-xs font-bold uppercase tracking-[0.14em] text-muted">{item.label}</span>
              <h3 class="mt-7 text-xl font-bold text-text">{item.title}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{item.description}</p>
              <span class="mt-8 flex items-center gap-2 text-sm font-semibold text-text">
                Visit
                <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-border/60">
      <div class="mx-auto max-w-4xl px-6 py-20 text-center lg:py-28">
        <div class="section-label mx-auto">The role of the editor</div>
        <h2 class="text-pretty text-3xl font-black leading-tight tracking-[-0.03em] text-text sm:text-5xl">
          Let the system handle the repeatable work. Keep the publication decision human.
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-muted">
          EAI organizes refinement, verification, publication metadata, and CMS handoff so editors can focus on whether the article deserves to be published.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a
            href="https://eai.envoyou.com/login"
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="eai_outbound_clicked"
            data-analytics-location="about_closing"
            class="btn-primary"
          >
            Open EAI
          </a>
          <a href="/fact-checked-publishing/" class="btn-secondary">
            Read about Quality Gate
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
